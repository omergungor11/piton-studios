# Kanonik site adresi — sitemap, robots, canonical, hreflang ve OG URL'leri buradan turetilir.
# Production'da MUTLAKA ayarlanmali; ayarlanmazsa Vercel URL'ine, o da yoksa localhost'a duser.
NEXT_PUBLIC_SITE_URL=https://pitonstudios.com

# ---- Veritabani (Neon Postgres) ----
# neon.com > yeni proje > Connection string (pooled degil, dogrudan)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/piton?sslmode=require

# Icerik kaynagi: static (varsayilan, data.ts + messages/*.json) veya db (Neon)
# Goc dogrulanana kadar static kalmali. Dogrulama: pnpm content:check
CONTENT_SOURCE=static

# ---- Sprint 3+ (henuz kullanilmiyor) ----

# Cloudflare R2 (medya)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=piton-media
# R2_PUBLIC_URL=https://media.pitonstudios.com

# Auth.js
# AUTH_SECRET=

# Resend (iletisim formu bildirimleri)
# RESEND_API_KEY=
