# Kanonik site adresi — sitemap, robots, canonical, hreflang ve OG URL'leri buradan turetilir.
# Production'da MUTLAKA ayarlanmali; ayarlanmazsa Vercel URL'ine, o da yoksa localhost'a duser.
NEXT_PUBLIC_SITE_URL=https://pitonstudios.com

# ---- Resend (iletisim formu) ----
# resend.com > API Keys. Ucretsiz 3.000 e-posta/ay.
# ZORUNLU: yoksa form acik hata verir ve kullaniciya dogrudan e-posta adresi gosterir.
RESEND_API_KEY=

# Bildirimlerin gidecegi adres (varsayilan: pitonstudios@gmail.com)
# CONTACT_NOTIFY_EMAIL=pitonstudios@gmail.com

# Gonderen adresi. Ayarlanmazsa Resend'in test gondericisi kullanilir
# (onboarding@resend.dev) — o da SADECE Resend hesabinin sahibine gonderebilir.
# Bu degisken ayarlandiginda ziyaretciye otomatik yanit da gonderilir.
# Once resend.com > Domains uzerinden alan adi dogrulanmali.
# CONTACT_FROM_EMAIL="Piton Studios <hello@pitonstudios.com>"
